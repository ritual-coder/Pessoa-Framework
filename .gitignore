# Ignore Python virtual environment
venv/
env/
ENV/

# Ignore Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Ignore logs
*.log

# Ignore OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore test artifacts
temp_*.txt
test_blob.txt

# Ignore local character experiments, but keep the shipped example.
# The negation must match the directory's casing exactly: git compares these
# patterns case-sensitively wherever core.ignorecase is false (i.e. Linux), so
# a mismatch silently ignores new files in the example character on those systems.
characters/*
!characters/Stack_And_Dagger/

# Keep logo and documentation assets
!*.png
!*.jpg
!*.svg
